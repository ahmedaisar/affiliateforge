# Control plane + generated store are different surfaces and neither holds secrets today.
# Local development backend (127.0.0.1 only)
CAIRN_API_PORT=8787
# CAIRN_DEV_TOKEN=   # unset → loopback is open (development only); set this before any non-loopback exposure
# CAIRN_DB=./data/cairn.db
# If the build is served on a public tunnel, bake <1 into the client so the UI admits it's read-only:
# VITE_DEMO_READ_ONLY=1 npm run build
